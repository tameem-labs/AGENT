# Safe, non-secret foundation settings. Copy to .env only for tools that load it.
# ZYRO itself reads process environment variables and does not auto-load .env files.
ZYRO_ENV=development
ZYRO_LOG_LEVEL=INFO
ZYRO_DATA_DIR=.zyro
# Explicit test-only OAuth provider. Set 0 to hide it.
ZYRO_ENABLE_DEVELOPMENT_OAUTH=1
